NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mern_ecommerce
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173

# Reserved for the AI Shopping Assistant (Gemini). Paste your own key from
# https://aistudio.google.com/apikey — never commit a real key.
GEMINI_API_KEY=
# Optional — defaults to gemini-2.5-flash if left blank.
GEMINI_MODEL=gemini-2.5-flash
